# dependencies
node_modules

# build output
dist
dist-ssr
*.local

# editor / OS
.DS_Store
*.log
logs
.vscode/*
!.vscode/extensions.json

# TS build info
node_modules/.tmp

# plan-state（フェーズ自動進行用・git 管理しない）
.claude/plan-state.json

# 開発時のスクショ・Playwright 出力
.playwright-mcp/
vocab-*.png

# Cloudflare Worker: ローカル設定（秘密情報）とローカル D1 等の状態。
# wrangler は .dev.vars だけでなく .env / .dev.vars.<env> も読むため、まとめて除外する
# （public リポジトリなので、うっかり .env に API トークンを書いた事故を必ず止める）。
.dev.vars*
!.dev.vars.example
.env*
.wrangler/

# データパイプライン: 生ダウンロードのみ除外（成果物の public/data は commit する）
pipeline/raw/
pipeline/__pycache__/
pipeline/*.pyc
